# OpenRouter LLM — ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_HTTP_REFERER=https://github.com/HH-Killer
# OPENROUTER_APP_NAME=HH-Killer

# Telegram Bot — токен: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Обязательный whitelist: Telegram user ID через запятую.
# Узнать ID: напишите боту /whoami (или посмотрите ID в ответе «Нет доступа»).
ALLOWED_USER_IDS=123456789

# Одновременные поиски на весь процесс (1 — безопасно для 1–2 GB RAM)
SEARCH_MAX_CONCURRENT=1

# Логи: пусто = только stdout (удобно в Docker без volume).
# Локально по умолчанию bot.log; в docker-compose задаётся /app/logs/bot.log
# LOG_FILE=

# Apify (бесплатный план ~$5/мес — https://console.apify.com)
APIFY_API_TOKEN=your_apify_token

# Бюджет Apify: на жизнь процесса (не сбрасывается между поисками)
APIFY_MAX_RESULTS=10
APIFY_MAX_RUNS_PER_SESSION=5
# Дополнительный суточный лимит (UTC). 0 = выключен.
APIFY_MAX_RUNS_PER_DAY=0
APIFY_FALLBACK_PLAYWRIGHT=true

# Apify Actors (можно не менять)
APIFY_LINKEDIN_ACTOR=curious_coder/linkedin-jobs-scraper
APIFY_INDEED_ACTOR=misceres/indeed-scraper
APIFY_WEB_SCRAPER=apify/web-scraper
# Web-scraper требует больше RAM (256 MB → crash). Free plan: 512–1024.
APIFY_WEB_SCRAPER_MEMORY_MB=512
APIFY_MEMORY_MB=256

# ── Anti-bot / Stealth Playwright ─────────────────────────────
# В Docker ставьте false: в образе bundled Chromium, не системный Chrome.
# Локально true, если установлен Google Chrome.
PLAYWRIGHT_USE_CHROME=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_LOCALE=pl-PL
PLAYWRIGHT_TIMEZONE=Europe/Warsaw

# Прокси (опционально): http://user:pass@host:port или socks5://host:port
# PLAYWRIGHT_PROXY=http://127.0.0.1:8080

# Список прокси через запятую — ротация при повторных попытках после блокировки
# PLAYWRIGHT_PROXIES=http://user:pass@host1:port,http://user:pass@host2:port

# Cookies/сессия после ручного логина (Playwright storage state JSON).
# Общий файл на всех пользователей процесса — не кладите личный аккаунт.
# PLAYWRIGHT_STORAGE_STATE=storage/pracuj_state.json

# Замедление действий (мс), помогает против rate-limit
# PLAYWRIGHT_SLOW_MO=100

# Не загружать картинки, шрифты и трекеры: быстрее и меньше следов
PLAYWRIGHT_BLOCK_ASSETS=true

# Минимальная пауза между запросами к одному домену (сек)
SCRAPER_DOMAIN_INTERVAL=2.5

# Свой User-Agent (иначе используется ротация согласованных профилей)
# PLAYWRIGHT_USER_AGENT=
